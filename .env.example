# ==============================================================================
# NexusCode AI Environment Configuration
# ==============================================================================
# DO NOT COMMIT .env.local TO GIT (IT IS PROPERLY IGNORED IN .gitignore)
# Copy this template to create your local environment:
#   cp .env.example .env.local
# ==============================================================================

# 1. Google OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. AI Provider API Key (Optional for live Gemini intelligence)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 3. App Environment
NODE_ENV=development
